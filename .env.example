# Neon Postgres connection string (required)
# Use the *pooled* URL from Neon dashboard for serverless/edge, or the direct
# URL for Node runtime. Must start with postgresql:// or postgres://
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/yourdb?sslmode=require

# Secret used to sign auth JWTs (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-random-32-char-string

# Admin credentials — only consumed by `npx tsx src/db/seed.ts`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
